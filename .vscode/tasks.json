// .vscode/tasks.json
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build multiple files",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g",
        "W03/solution/main.cpp",
        "W03/solution/complex.cpp",
        "-o",
        "${workspaceFolder}/main"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build active file",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "WSL build active file",
      "type": "shell",
      "command": "/usr/bin/g++",
      "args": [
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "WSL build multiple files",
      "type": "shell",
      "command": "/usr/bin/g++",
      "args": [
        "-g",
        "*.cpp",
        "-o",
        "main"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$gcc"]
    }
  ]
}
